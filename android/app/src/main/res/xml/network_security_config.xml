<?xml version="1.0" encoding="utf-8"?>
<!--
  The Go backend runs on the user's own machine/local network (e.g.
  http://192.168.x.x:8787) without TLS, so cleartext traffic must be
  permitted. Delta Exchange's own API is HTTPS and unaffected by this.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
