<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Backend connection -->
        <TextView style="@style/SettingsLabel" android:layout_marginTop="0dp" android:text="@string/settings_section_backend" android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/inputBackendUrl"
            style="@style/SettingsInput"
            android:hint="@string/hint_backend_url"
            android:inputType="textUri" />

        <!-- Delta account -->
        <TextView style="@style/SettingsLabel" android:text="@string/settings_section_delta" android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/inputDeltaBaseUrl"
            style="@style/SettingsInput"
            android:hint="@string/hint_delta_base_url"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/inputApiKey"
            style="@style/SettingsInput"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_api_key"
            android:inputType="textVisiblePassword" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/inputApiSecret"
                style="@style/SettingsInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/hint_api_secret"
                android:inputType="textPassword" />

            <ImageButton
                android:id="@+id/toggleSecretVisibility"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Show/hide secret"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/carbon_text_secondary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testKeysButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/action_test_keys"
            app:strokeColor="@color/carbon_blue"
            android:textColor="@color/carbon_blue" />

        <!-- Trading parameters -->
        <TextView style="@style/SettingsLabel" android:text="@string/settings_section_trading" android:layout_width="wrap_content" android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/inputSymbol"
                style="@style/SettingsInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/hint_symbol"
                android:inputType="textCapCharacters" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resolveSymbolButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/action_resolve_symbol"
                android:textSize="11sp"
                app:strokeColor="@color/carbon_blue"
                android:textColor="@color/carbon_blue" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputProductId"
            style="@style/SettingsInput"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_product_id"
            android:inputType="number" />

        <EditText
            android:id="@+id/inputLot"
            style="@style/SettingsInput"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_lot"
            android:inputType="number" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/inputLeverage"
                style="@style/SettingsInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/hint_leverage"
                android:inputType="number" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyLeverageButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/action_apply_leverage"
            app:strokeColor="@color/carbon_blue"
            android:textColor="@color/carbon_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/carbon_blue_dark"
            android:text="@string/action_save"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/settingsStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/carbon_text_muted"
            android:textSize="12sp" />

        <View android:layout_width="match_parent" android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
